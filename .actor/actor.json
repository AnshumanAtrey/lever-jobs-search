{
    "actorSpecification": 1,
    "name": "deel-jobs-search",
    "title": "Deel Jobs Scraper & API - All Deel ATS Career Pages with Pay",
    "description": "Deel jobs scraper and API for every company on jobs.deel.com, searched live by job title, location, remote, job type and date, newest first. 159 companies, 1,300+ open jobs, pay on a third of them. The site:jobs.deel.com dork done at the source: full descriptions, dead-link checks.",
    "version": "1.0",
    "buildTag": "latest",
    "categories": [
        "JOBS",
        "LEAD_GENERATION",
        "OPEN_SOURCE"
    ],
    "input": "./INPUT_SCHEMA.json",
    "output": "./output_schema.json",
    "dockerfile": "../Dockerfile",
    "readme": "../README.md",
    "minMemoryMbytes": 512,
    "maxMemoryMbytes": 4096,
    "storages": {
        "dataset": {
            "actorSpecification": 1,
            "title": "Deel jobs",
            "description": "One row per job, newest first: title, company, locations, work type, job type, department, team, pay, posting date and links; with details on, also the description, pay as numbers and country. The run summary is the OUTPUT record, not a row.",
            "fields": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Job title (title)",
                        "description": "The job title as the company wrote it on Deel.",
                        "example": "Business Development Associate"
                    },
                    "company": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Company name (company)",
                        "description": "The company, as it names itself on its Deel career page.",
                        "example": "Klarna"
                    },
                    "location": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Main location (location)",
                        "description": "The job's main place, as the company typed it, with the country added when the text does not say it.",
                        "example": "Vienna, Austria"
                    },
                    "otherLocations": {
                        "type": [
                            "array",
                            "null"
                        ],
                        "title": "Other locations (otherLocations)",
                        "description": "Every other place the job is posted for. One job can list dozens of countries.",
                        "example": [
                            "Berlin, Germany"
                        ],
                        "items": {
                            "type": "string"
                        }
                    },
                    "workType": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Remote or onsite (workType)",
                        "description": "remote, hybrid or onsite, as the company set it on Deel; when it set nothing, read from the title and location.",
                        "example": "onsite"
                    },
                    "employmentType": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Job type (employmentType)",
                        "description": "full-time, part-time, contract, intern or temporary, as the company set it.",
                        "example": "full-time"
                    },
                    "department": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Hiring department (department)",
                        "description": "The department the job is in.",
                        "example": "Business Development"
                    },
                    "team": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Hiring team (team)",
                        "description": "The team the job is in.",
                        "example": "Partnerships"
                    },
                    "salary": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Pay summary (salary)",
                        "description": "The pay the company publishes: currency and amount or range. Deel gives no period, and hourly, monthly and yearly amounts are all in use, so read it with the job. Empty when the company shows no pay.",
                        "example": "EUR 69,786 - 78,161"
                    },
                    "postedAt": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Posted on (postedAt)",
                        "description": "When the job was published, exact to the second, in UTC: the date Deel gives Google as datePosted, not the day the draft was made.",
                        "example": "2026-07-17T14:16:35.046Z"
                    },
                    "jobUrl": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Job link (jobUrl)",
                        "description": "The job's page on the company's Deel career page.",
                        "example": "https://jobs.deel.com/klarna/job-details/87bd8299-48ef-4c79-9005-0347ecf8b054/overview"
                    },
                    "applyUrl": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Apply link (applyUrl)",
                        "description": "The link to apply on Deel.",
                        "example": "https://jobs.deel.com/klarna/job-details/87bd8299-48ef-4c79-9005-0347ecf8b054/application"
                    },
                    "status": {
                        "type": "string",
                        "title": "Still open? (status)",
                        "description": "open for every search result (read live during the run). For a checked link: open, closed (Deel says the posting is no longer published) or not found (no such job or career page).",
                        "example": "open"
                    },
                    "companySlug": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Ashby board name (companySlug)",
                        "description": "The career page: the name in its address, as in klarna for jobs.deel.com/klarna. Its capitals matter. A company with no name set has a long ID here.",
                        "example": "klarna"
                    },
                    "jobId": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Job ID (jobId)",
                        "description": "Deel's ID of the job posting.",
                        "example": "87bd8299-48ef-4c79-9005-0347ecf8b054"
                    },
                    "checkedAt": {
                        "type": "string",
                        "title": "Checked at (checkedAt)",
                        "description": "When the run read the boards, in UTC.",
                        "example": "2026-10-30T11:57:07+00:00"
                    },
                    "description": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Job description (description)",
                        "description": "The job description as plain text, with details on.",
                        "example": "As a Business Development Associate, you will drive Klarna's commercial growth in the Austrian market."
                    },
                    "descriptionHtml": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Description as HTML (descriptionHtml)",
                        "description": "The job description as the company wrote it in HTML, with details on.",
                        "example": "<p>As a Business Development Associate, you will drive Klarna's commercial growth in the Austrian market.</p>"
                    },
                    "salaryMin": {
                        "type": [
                            "number",
                            "null"
                        ],
                        "title": "Lowest pay (salaryMin)",
                        "description": "With details on: the lowest pay as a number. Empty when the company shows no pay.",
                        "example": 69786
                    },
                    "salaryMax": {
                        "type": [
                            "number",
                            "null"
                        ],
                        "title": "Highest pay (salaryMax)",
                        "description": "With details on: the highest pay as a number. Some jobs give only one amount.",
                        "example": 78161
                    },
                    "salaryCurrency": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Pay currency (salaryCurrency)",
                        "description": "With details on: the currency code of the pay.",
                        "example": "EUR"
                    },
                    "country": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Job country (country)",
                        "description": "The country of the job's main place, when Deel stores one, with details on.",
                        "example": "Austria"
                    },
                    "countryCode": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Country code (countryCode)",
                        "description": "The two-letter country code, with details on.",
                        "example": "AT"
                    },
                    "platform": {
                        "type": "string",
                        "title": "Job platform (platform)",
                        "description": "The ATS the job came from: always deel here.",
                        "example": "deel"
                    }
                }
            },
            "views": {
                "jobs": {
                    "title": "Jobs",
                    "description": "One row per job: what it is, where, remote or not, the pay and when it was posted, with its link.",
                    "transformation": {
                        "fields": [
                            "title",
                            "company",
                            "location",
                            "workType",
                            "salary",
                            "postedAt",
                            "jobUrl",
                            "status"
                        ]
                    },
                    "display": {
                        "component": "table",
                        "properties": {
                            "title": {
                                "label": "Job title (title)",
                                "format": "text"
                            },
                            "company": {
                                "label": "Company name (company)",
                                "format": "text"
                            },
                            "location": {
                                "label": "Main location (location)",
                                "format": "text"
                            },
                            "workType": {
                                "label": "Remote or onsite (workType)",
                                "format": "text"
                            },
                            "salary": {
                                "label": "Pay summary (salary)",
                                "format": "text"
                            },
                            "postedAt": {
                                "label": "Posted on (postedAt)",
                                "format": "date"
                            },
                            "jobUrl": {
                                "label": "Job link (jobUrl)",
                                "format": "link"
                            },
                            "status": {
                                "label": "Still open? (status)",
                                "format": "text"
                            }
                        }
                    }
                },
                "details": {
                    "title": "Details",
                    "description": "The description, job type, department, team, pay as numbers and every other field of each job.",
                    "transformation": {
                        "fields": [
                            "title",
                            "company",
                            "description",
                            "employmentType",
                            "department",
                            "team",
                            "salaryMin",
                            "salaryMax",
                            "salaryCurrency",
                            "countryCode",
                            "otherLocations",
                            "applyUrl",
                            "companySlug",
                            "jobId",
                            "checkedAt"
                        ]
                    },
                    "display": {
                        "component": "table",
                        "properties": {
                            "title": {
                                "label": "Job title (title)",
                                "format": "text"
                            },
                            "company": {
                                "label": "Company name (company)",
                                "format": "text"
                            },
                            "description": {
                                "label": "Job description (description)",
                                "format": "text"
                            },
                            "employmentType": {
                                "label": "Job type (employmentType)",
                                "format": "text"
                            },
                            "department": {
                                "label": "Hiring department (department)",
                                "format": "text"
                            },
                            "team": {
                                "label": "Hiring team (team)",
                                "format": "text"
                            },
                            "salaryMin": {
                                "label": "Lowest pay (salaryMin)",
                                "format": "number"
                            },
                            "salaryMax": {
                                "label": "Highest pay (salaryMax)",
                                "format": "number"
                            },
                            "salaryCurrency": {
                                "label": "Pay currency (salaryCurrency)",
                                "format": "text"
                            },
                            "countryCode": {
                                "label": "Country code (countryCode)",
                                "format": "text"
                            },
                            "otherLocations": {
                                "label": "Other locations (otherLocations)",
                                "format": "array"
                            },
                            "applyUrl": {
                                "label": "Apply link (applyUrl)",
                                "format": "link"
                            },
                            "companySlug": {
                                "label": "Ashby board name (companySlug)",
                                "format": "text"
                            },
                            "jobId": {
                                "label": "Job ID (jobId)",
                                "format": "text"
                            },
                            "checkedAt": {
                                "label": "Checked at (checkedAt)",
                                "format": "date"
                            }
                        }
                    }
                }
            }
        },
        "keyValueStore": {
            "actorKeyValueStoreSchemaVersion": 1,
            "title": "Run summary",
            "description": "The OUTPUT record: how many boards were read and matched, how many jobs matched and were saved, the checked links, the notes about how the input was read and the settings used.",
            "collections": {
                "summary": {
                    "title": "Run summary (OUTPUT)",
                    "description": "Status, message, counts for the boards and jobs, checked links, notes and settings.",
                    "key": "OUTPUT"
                }
            }
        }
    }
}