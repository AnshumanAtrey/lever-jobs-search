{
    "actorSpecification": 1,
    "name": "lever-jobs-search",
    "title": "Lever Jobs Scraper & API - Salary, Remote, Last 24 Hours",
    "description": "Lever jobs scraper and API for 2,300+ companies on jobs.lever.co, searched live by job title, location, remote, job type and posting date, newest first. 76,000+ open jobs, salary with its period on a third of them, no Lever API key. The site:jobs.lever.co dork done at the source.",
    "version": "1.0",
    "buildTag": "latest",
    "categories": [
        "JOBS",
        "LEAD_GENERATION",
        "OPEN_SOURCE"
    ],
    "input": "./INPUT_SCHEMA.json",
    "output": "./output_schema.json",
    "dockerfile": "../Dockerfile",
    "readme": "../README.md",
    "minMemoryMbytes": 2048,
    "maxMemoryMbytes": 4096,
    "storages": {
        "dataset": {
            "actorSpecification": 1,
            "title": "Lever jobs",
            "description": "One row per job, newest first: title, company, locations, work type, job type, department, team, pay, posting date and links; with details on, also the description, pay as numbers with its period, and the country. The run summary is the OUTPUT record, not a row.",
            "fields": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Job title (title)",
                        "description": "The job title as the company wrote it on Lever.",
                        "example": "Data Scientist"
                    },
                    "company": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Company name (company)",
                        "description": "The company, as Lever's job feed names it.",
                        "example": "Prima"
                    },
                    "location": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Main location (location)",
                        "description": "The job's main place, as the company typed it on Lever. A job with no place of its own shows its country.",
                        "example": "Turin"
                    },
                    "otherLocations": {
                        "type": [
                            "array",
                            "null"
                        ],
                        "title": "Other locations (otherLocations)",
                        "description": "Every other place the company listed for the job; 8.2% of jobs name more than one.",
                        "example": [
                            "San Mateo, California"
                        ],
                        "items": {
                            "type": "string"
                        }
                    },
                    "workType": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Remote or onsite (workType)",
                        "description": "remote, hybrid or onsite, as the company set it on Lever (99% of jobs). Where it set none: remote when a location or the title says Remote or worldwide, hybrid when the title says Hybrid, else empty.",
                        "example": "hybrid"
                    },
                    "employmentType": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Job type (employmentType)",
                        "description": "full-time, part-time, contract, intern or temporary, read from the company's own job type words on Lever (such as Full-time, CDI or Contract: Part-Time). Empty when the company gave no job type words or words that name no single type, such as Full-time or Part-time: 18% of jobs.",
                        "example": "full-time"
                    },
                    "department": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Hiring department (department)",
                        "description": "The department the job is in, as the company set it on Lever (71% of jobs).",
                        "example": "Pricing & Underwriting"
                    },
                    "team": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Hiring team (team)",
                        "description": "The team the job is in, as the company set it on Lever.",
                        "example": "Pricing & Underwriting Italy"
                    },
                    "salary": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Pay summary (salary)",
                        "description": "The pay range the company publishes on Lever: currency, amount or range, and the period Lever states with it. Empty when no pay is shown, about two jobs in three.",
                        "example": "EUR 45,000 - 75,000 per year"
                    },
                    "postedAt": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Posted on (postedAt)",
                        "description": "When the job was created on Lever, exact to the second, in UTC: the date the job's own page gives Google as datePosted. Jobs can stay open for years.",
                        "example": "2026-10-30T16:39:29Z"
                    },
                    "jobUrl": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Job link (jobUrl)",
                        "description": "The job's page on the company's Lever job site.",
                        "example": "https://jobs.eu.lever.co/prima/5df3ae85-e2db-4e2a-b868-16e57d193a47"
                    },
                    "applyUrl": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Apply link (applyUrl)",
                        "description": "The link to apply on Lever. Empty for a checked link that is closed or not found.",
                        "example": "https://jobs.eu.lever.co/prima/5df3ae85-e2db-4e2a-b868-16e57d193a47/apply"
                    },
                    "status": {
                        "type": "string",
                        "title": "Still open? (status)",
                        "description": "open for every search result (read live during the run). For a checked link: open, closed (Lever no longer lists the job, or never had that ID) or not found (no such Lever job site).",
                        "example": "open"
                    },
                    "platform": {
                        "type": "string",
                        "title": "Job platform (platform)",
                        "description": "The ATS the job came from: always lever here.",
                        "example": "lever"
                    },
                    "companySlug": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Lever job site (companySlug)",
                        "description": "The Lever job site: the name in its address, as palantir in jobs.lever.co/palantir. Its capitals matter. A site on Lever's EU host (jobs.eu.lever.co) ends in /eu, except on a checked job link typed with jobs.lever.co.",
                        "example": "prima/eu"
                    },
                    "jobId": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Job ID (jobId)",
                        "description": "Lever's ID of the job posting.",
                        "example": "5df3ae85-e2db-4e2a-b868-16e57d193a47"
                    },
                    "checkedAt": {
                        "type": "string",
                        "title": "Checked at (checkedAt)",
                        "description": "When the run read the job sites, in UTC.",
                        "example": "2026-11-02T23:15:26+00:00"
                    },
                    "description": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Job description (description)",
                        "description": "The job description as plain text, with details on: the description, each list under its heading, the pay note and the closing text, as the job page shows them.",
                        "example": "Are you looking for a new challenge?\nFancy helping us shape the future of motor insurance?\nPrima could be the place for you."
                    },
                    "descriptionHtml": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Description as HTML (descriptionHtml)",
                        "description": "The same description in HTML, as the company wrote it, with details on.",
                        "example": "<p><span style=\"font-size: 16px; color: #000000;\">Are you looking for a new challenge?</span></p>"
                    },
                    "salaryMin": {
                        "type": [
                            "number",
                            "null"
                        ],
                        "title": "Lowest pay (salaryMin)",
                        "description": "With details on: the lowest pay as a number. Empty when the company shows no pay.",
                        "example": 45000
                    },
                    "salaryMax": {
                        "type": [
                            "number",
                            "null"
                        ],
                        "title": "Highest pay (salaryMax)",
                        "description": "With details on: the highest pay as a number; the same as the lowest when the company gives one amount.",
                        "example": 75000
                    },
                    "salaryCurrency": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Pay currency (salaryCurrency)",
                        "description": "With details on: the currency code of the pay.",
                        "example": "EUR"
                    },
                    "salaryPeriod": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Pay period (salaryPeriod)",
                        "description": "With details on: what the pay is per, as Lever states it: year, month, week, day or hour. Empty for pay every two weeks, twice a month, every two months or one time (the salary text says which) and when there is no pay; never guessed.",
                        "example": "year"
                    },
                    "country": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Job country (country)",
                        "description": "With details on: the country of the job's main place, as Lever stores it.",
                        "example": "Italy"
                    },
                    "countryCode": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Country code (countryCode)",
                        "description": "With details on: the two-letter country code of the job's main place.",
                        "example": "IT"
                    }
                }
            },
            "views": {
                "jobs": {
                    "title": "Jobs",
                    "description": "One row per job: what it is, where, remote or not, the pay and when it was posted, with its link.",
                    "transformation": {
                        "fields": [
                            "title",
                            "company",
                            "location",
                            "workType",
                            "salary",
                            "postedAt",
                            "jobUrl",
                            "status"
                        ]
                    },
                    "display": {
                        "component": "table",
                        "properties": {
                            "title": {
                                "label": "Job title (title)",
                                "format": "text"
                            },
                            "company": {
                                "label": "Company name (company)",
                                "format": "text"
                            },
                            "location": {
                                "label": "Main location (location)",
                                "format": "text"
                            },
                            "workType": {
                                "label": "Remote or onsite (workType)",
                                "format": "text"
                            },
                            "salary": {
                                "label": "Pay summary (salary)",
                                "format": "text"
                            },
                            "postedAt": {
                                "label": "Posted on (postedAt)",
                                "format": "date"
                            },
                            "jobUrl": {
                                "label": "Job link (jobUrl)",
                                "format": "link"
                            },
                            "status": {
                                "label": "Still open? (status)",
                                "format": "text"
                            }
                        }
                    }
                },
                "details": {
                    "title": "Details",
                    "description": "The description, job type, department, team, pay as numbers with its period, the country, other places, the apply link and the IDs of each job.",
                    "transformation": {
                        "fields": [
                            "title",
                            "company",
                            "description",
                            "employmentType",
                            "department",
                            "team",
                            "salaryMin",
                            "salaryMax",
                            "salaryCurrency",
                            "salaryPeriod",
                            "country",
                            "otherLocations",
                            "applyUrl",
                            "companySlug",
                            "jobId",
                            "checkedAt"
                        ]
                    },
                    "display": {
                        "component": "table",
                        "properties": {
                            "title": {
                                "label": "Job title (title)",
                                "format": "text"
                            },
                            "company": {
                                "label": "Company name (company)",
                                "format": "text"
                            },
                            "description": {
                                "label": "Job description (description)",
                                "format": "text"
                            },
                            "employmentType": {
                                "label": "Job type (employmentType)",
                                "format": "text"
                            },
                            "department": {
                                "label": "Hiring department (department)",
                                "format": "text"
                            },
                            "team": {
                                "label": "Hiring team (team)",
                                "format": "text"
                            },
                            "salaryMin": {
                                "label": "Lowest pay (salaryMin)",
                                "format": "number"
                            },
                            "salaryMax": {
                                "label": "Highest pay (salaryMax)",
                                "format": "number"
                            },
                            "salaryCurrency": {
                                "label": "Pay currency (salaryCurrency)",
                                "format": "text"
                            },
                            "salaryPeriod": {
                                "label": "Pay period (salaryPeriod)",
                                "format": "text"
                            },
                            "country": {
                                "label": "Job country (country)",
                                "format": "text"
                            },
                            "otherLocations": {
                                "label": "Other locations (otherLocations)",
                                "format": "array"
                            },
                            "applyUrl": {
                                "label": "Apply link (applyUrl)",
                                "format": "link"
                            },
                            "companySlug": {
                                "label": "Lever job site (companySlug)",
                                "format": "text"
                            },
                            "jobId": {
                                "label": "Job ID (jobId)",
                                "format": "text"
                            },
                            "checkedAt": {
                                "label": "Checked at (checkedAt)",
                                "format": "date"
                            }
                        }
                    }
                }
            }
        },
        "keyValueStore": {
            "actorKeyValueStoreSchemaVersion": 1,
            "title": "Run summary",
            "description": "The OUTPUT record: how many job sites were read and matched, how many jobs matched and were saved, the checked links, the notes about how the input was read and the settings used.",
            "collections": {
                "summary": {
                    "title": "Run summary (OUTPUT)",
                    "description": "Status, message, counts for the job sites and jobs, checked links, job sites that could not be read, notes and settings.",
                    "key": "OUTPUT"
                }
            }
        }
    }
}
